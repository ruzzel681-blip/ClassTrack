rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admin accounts cannot be created from the app. They are set up once, by
    // hand, in the Firebase console (see README).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin' &&
        getUserData().approved == true;
    }

    // Teacher powers: an approved teacher, OR the admin (the admin also acts as a teacher).
    function isApprovedTeacher() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'teacher' &&
        getUserData().approved == true
      );
    }

    // A student may only add THEMSELVES to a class (and only if not blocked),
    // or remove THEMSELVES from it. Nothing else on the class can change.
    function isSelfJoinOrLeave() {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentUids', 'studentsMap']) &&
        (
          (
            request.resource.data.get('studentUids', []).toSet()
              .difference(resource.data.get('studentUids', []).toSet()) == [request.auth.uid].toSet() &&
            resource.data.get('studentUids', []).toSet()
              .difference(request.resource.data.get('studentUids', []).toSet()).size() == 0 &&
            !(request.auth.uid in resource.data.get('blockedStudentUids', []))
          ) ||
          (
            resource.data.get('studentUids', []).toSet()
              .difference(request.resource.data.get('studentUids', []).toSet()) == [request.auth.uid].toSet() &&
            request.resource.data.get('studentUids', []).toSet()
              .difference(resource.data.get('studentUids', []).toSet()).size() == 0
          )
        );
    }

    function isStudent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'student';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();

      // Sign-up: you can only create your OWN profile. Students are active right
      // away; teachers MUST start unapproved. Nobody can create an admin profile
      // or pre-set the revoked flag.
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.get('revoked', false) == false &&
        (
          (request.resource.data.role == 'student' && request.resource.data.approved == true) ||
          (request.resource.data.role == 'teacher' && request.resource.data.approved == false)
        );

      allow update: if isSignedIn() && (
        // 1) Your own profile: identity, role and every approval field are locked.
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'uid', 'role', 'approved', 'approvedAt', 'approvedByUid', 'approvedByName',
            'revoked', 'revokedReason', 'revokedAt', 'revokedByUid', 'revokedByName'
          ])
        ) ||
        // 2) Admin: approve, reject, revoke or restore TEACHER accounts.
        (
          isAdmin() &&
          resource.data.role == 'teacher' &&
          request.resource.data.role == 'teacher' &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'approved', 'approvedAt', 'approvedByUid', 'approvedByName',
            'revoked', 'revokedReason', 'revokedAt', 'revokedByUid', 'revokedByName',
            'updatedAt'
          ])
        )
      );

      // Only an admin can delete a profile, and never an admin's.
      allow delete: if isAdmin() && resource.data.role != 'admin';
    }

    // Classrooms
    match /classes/{classId} {
      allow read: if isSignedIn();

      // Only teachers (and the admin) can create classes, and only under their own name.
      allow create: if isApprovedTeacher() && request.resource.data.teacherId == request.auth.uid;

      // Only the teacher who created the class (or the admin) can edit it or
      // remove students. A student can only add/remove themselves.
      allow update: if (
        isApprovedTeacher() &&
        (isAdmin() || resource.data.teacherId == request.auth.uid) &&
        request.resource.data.teacherId == resource.data.teacherId
      ) || isSelfJoinOrLeave();

      // Only the class owner (or the admin) can delete a class.
      allow delete: if isApprovedTeacher() &&
        (isAdmin() || resource.data.teacherId == request.auth.uid);
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if isApprovedTeacher() || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isApprovedTeacher() || (isStudent() && request.resource.data.studentUid == request.auth.uid);
      allow update: if isApprovedTeacher();
      allow delete: if isApprovedTeacher();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid ||
        isApprovedTeacher()
      );
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isApprovedTeacher()
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isApprovedTeacher()
      );
    }

    // Broadcasts: a teacher's message to ALL students (works even with no class).
    // Anyone signed in can read; only teachers (and the admin) can post, under their
    // own name; only the author or the admin can remove one.
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create: if isApprovedTeacher() && request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isApprovedTeacher() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Announcement comments
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow delete: if isSignedIn();
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.teacherId == request.auth.uid ||
        isApprovedTeacher()
      );
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        isApprovedTeacher()
      );
      allow delete: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        isApprovedTeacher()
      );
    }

    // Submissions
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isApprovedTeacher()
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentUid == request.auth.uid ||
        isApprovedTeacher()
      );
      allow update: if isSignedIn() && (
        (request.resource.data.studentUid == request.auth.uid &&
         resource.data.studentUid == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grade', 'feedback', 'gradedAt', 'gradedByUid', 'gradedByName'])) ||
        isApprovedTeacher()
      );
      allow delete: if isApprovedTeacher() || (
        isSignedIn() &&
        resource.data.studentUid == request.auth.uid &&
        !('grade' in resource.data)
      );
    }

    // Direct Messages
    match /direct_messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }

    // Audit logs (immutable, create-only)
    match /auditLogs/{logId} {
      allow read: if isApprovedTeacher() || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
